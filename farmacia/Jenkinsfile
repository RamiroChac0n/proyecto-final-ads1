pipeline {
    agent any
    parameters {
        string(
            name: 'FARMACIA_NOMBRE',
            description: 'Slug único de la farmacia (sin espacios, minúsculas). Ej: farmacia-abc'
        )
        string(
            name: 'APP_PORT',
            description: 'Puerto HTTP libre en el VPS para esta instancia. Ej: 8081'
        )
        string(
            name: 'DB_NAME',
            description: 'Nombre de la base de datos PostgreSQL. Ej: db_farmacia_abc'
        )
        string(
            name: 'DB_USER',
            description: 'Usuario de PostgreSQL. Ej: user_abc'
        )
        password(
            name: 'DB_PASS',
            description: 'Contraseña de PostgreSQL (enmascarada en logs).'
        )
        string(
            name: 'VPS_HOST',
            description: 'IP o dominio del VPS. Ej: 192.168.1.1'
        )
        string(
            name: 'VPS_USER',
            description: 'Usuario SSH del VPS. Ej: user'
        )        
    }

    tools {
        maven 'Maven-3.9'
        jdk   'JDK-21'
    }

    stages {

        stage('Validate Params') {
            steps {
                script {
                    if (!params.FARMACIA_NOMBRE?.trim()) { error('FARMACIA_NOMBRE es obligatorio') }
                    if (!params.APP_PORT?.trim())         { error('APP_PORT es obligatorio') }
                    if (!params.DB_NAME?.trim())           { error('DB_NAME es obligatorio') }
                    if (!params.DB_USER?.trim())           { error('DB_USER es obligatorio') }
                    if (!params.DB_PASS?.toString()?.trim()) { error('DB_PASS es obligatorio') }
                    if (!params.VPS_HOST?.trim()) { error('VPS_HOST es obligatorio') }
                    if (!params.VPS_USER?.trim()) { error('VPS_USER es obligatorio') }                    
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test -f farmacia/pom.xml -Dmaven.test.failure.ignore=true'
            }
            post {
                always {
                    junit 'farmacia/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: ['vps-ssh-key']) {
                    withEnv(["DB_PASS=${params.DB_PASS}"]) {
                        sh """
                            echo "[farmacia]" > inventory.ini
                            echo "${params.VPS_HOST} ansible_user=${params.VPS_USER} ansible_ssh_private_key_file=~/.ssh/id_rsa" >> inventory.ini
                            ansible-playbook \\
                                -i inventory.ini \\
                                ansible/playbook.yml \\
                                -e "farmacia_nombre=${params.FARMACIA_NOMBRE}" \\
                                -e "app_port=${params.APP_PORT}" \\
                                -e "db_name=${params.DB_NAME}" \\
                                -e "db_user=${params.DB_USER}" \\
                                -e "db_pass=\$DB_PASS"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Instancia '${params.FARMACIA_NOMBRE}' desplegada en puerto ${params.APP_PORT}."
        }
        failure {
            echo "Pipeline fallido para '${params.FARMACIA_NOMBRE}'. Revisar los logs."
        }
    }
}
